# Comfy Developer Platform (Comfy Cloud API key). Never commit a real key.
COMFY_API_KEY=

# Map provider. Default: open sources (Photon / OSM / OpenFreeMap / Panoramax), no key.
NEXT_PUBLIC_MAP_PROVIDER=open
# Google option, OFF by default. Restricted key only, never committed. See docs/google-maps/.
# NEXT_PUBLIC_MAP_PROVIDER=google
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=
# NEXT_PUBLIC_GOOGLE_MAP_ID=
